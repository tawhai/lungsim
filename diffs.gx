<   
<   subroutine set_perfusion_gradient(Gdirn,cardiac_output,COV,Qmax,Qmin)
<     !*set_perfusion_gradient*: initialises a linear gradient in perfusion
<     ! with iso-gravitational heterogeneity defined by the COV
<     !DEC$ ATTRIBUTES DLLEXPORT,ALIAS:"SO_SET_PERFUSION_GRADIENT" :: SET_PERFUSION_GRADIENT
<     
<     integer,intent(in) :: Gdirn
<     real(dp),intent(in) :: COV,cardiac_output,Qmax,Qmin
<     ! Local variables
<     integer :: ne,np2,nunit,xyz_index
<     real(dp) ::  maxflow,max_z,min_z,Qmean,rando,range_z,Xi,xyz_multiply
<     real(dp),allocatable :: random_list(:)
<     character(len=60) :: sub_name
161,238c132,139
<     ! --------------------------------------------------------------------------
<     
<     sub_name = 'set_perfusion_gradient'
<     call enter_exit(sub_name,1)
<     
< !!! allocate memory for the gasex_field array, if not already allocated
<     if(.not.allocated(gasex_field)) allocate(gasex_field(num_gx,num_units))
<     
<     xyz_index = abs(Gdirn)
<     if(Gdirn.lt.0)then
<        xyz_multiply = -1.0_dp
<     else
<        xyz_multiply = 1.0_dp
<     endif
<     
<     if(abs(Qmax-Qmin) < 1.0e-6_dp)then ! all the same
<        gasex_field(ng_Qdot,1:num_units) = Qmax
<     else        
< !!! for each unit find the maximum and minimum coordinates in the Gdirn direction
<        max_z = -1.0e+6_dp
<        min_z = 1.0e+6_dp
<        do nunit = 1,num_units
<           ne = units(nunit)
<           np2 = elem_nodes(2,ne)
<           max_z = max(max_z,xyz_multiply*node_xyz(xyz_index,np2))
<           min_z = min(min_z,xyz_multiply*node_xyz(xyz_index,np2))
<        enddo !nunit
<        range_z = abs(max_z-min_z)
<        if(abs(range_z).le.1.0e-5_dp) range_z = 1.0_dp
<        
< !!! for each unit allocate a flow based on a gradient in the Gdirn direction, and
< !!! perturb by a user-defined COV. This should be calling a random number generator.
<        allocate(random_list(2*num_units))
<        call random_number(random_list) ! returns pseudorandom numbers with uniform distribution (0-1)
<        do nunit = 1,num_units
<           ne = units(nunit)
<           np2 = elem_nodes(2,ne) !end node
<           Xi = (xyz_multiply*node_xyz(xyz_index,np2)-min_z)/range_z
<           ! use Box-Muller transform to generate random numbers with normal distribution
<           rando = sqrt(-2.0_dp * log(random_list(nunit))) * &
<                cos(2.0_dp*pi*random_list(nunit+num_units))
<           Qmean = Qmax*Xi+Qmin*(1.0_dp-Xi)
<           gasex_field(ng_Qdot,nunit) = max(0.1e-6_dp*Qmean,Qmean*(1.0_dp + rando*COV))
<        enddo !nunit
<        deallocate(random_list)
<     endif
< 
<     do nunit = 1,num_units
<        ne = units(nunit)
<        elem_field(ne_Qdot,ne) = gasex_field(ng_Qdot,nunit)
<        unit_field(nu_perf,nunit) = elem_field(ne_Qdot,ne)
<     enddo
< 
< !!! the following SHOULD take into account the smaller flow at units that subtend symmetric
< !!! paths. i.e. that have higher number of effective units.
< !!! sum the fields up the tree, and normalise
<     call sum_elem_field_from_periphery(ne_Qdot) !sum the blood flows recursively UP the tree
<     maxflow = elem_field(ne_Qdot,1)
<     gasex_field(ng_Qdot,1:num_units) = cardiac_output*gasex_field(ng_Qdot,1:num_units)/maxflow
<     unit_field(nu_perf,1:num_units) = cardiac_output*unit_field(nu_perf,1:num_units)/maxflow
<     elem_field(ne_Qdot,1:num_elems) = cardiac_output*elem_field(ne_Qdot,1:num_elems)/maxflow
< 
<     call enter_exit(sub_name,2)
< 
<   end subroutine set_perfusion_gradient
<   
